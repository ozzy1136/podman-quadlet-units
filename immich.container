[Unit]
Description=Immich server
Documentation=https://docs.immich.app/overview/quick-start
After=immich-redis.service immich-db.service immich-ml.service
Requires=immich-redis.service immich-db.service immich-ml.service

[Container]
Pod=immich.pod
ContainerName=immich
Image=ghcr.io/immich-app/immich-server:release

AddDevice=nvidia.com/gpu=all

Volume=/mnt/podman/data/media/photos_and_videos/:/data
Volume=/etc/localtime:/etc/localtime:ro

Secret=immich_db_password,type=env,target=DB_PASSWORD

Environment=IMMICH_LOG_LEVEL=debug
Environment=DB_HOSTNAME=localhost
Environment=DB_USERNAME=postgres
Environment=DB_DATABASE_NAME=immich
Environment=REDIS_HOSTNAME=localhost
